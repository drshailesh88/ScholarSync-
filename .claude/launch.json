{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nextjs-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "latex-compiler",
      "runtimeExecutable": "node",
      "runtimeArgs": ["services/latex-compiler/server.js"],
      "port": 8080
    },
    {
      "name": "docling-service",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app:app", "--host", "0.0.0.0", "--port", "8001"],
      "port": 8001
    }
  ]
}
